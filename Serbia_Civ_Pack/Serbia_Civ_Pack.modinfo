  <Properties>
    <Name>Serbia Civilization Pack</Name>
    <Description>Adds Serbia featuring Josip Broz Tito, Draza Mihailovic, Slobodan Milosevic, and Stefan Dusan.</Description>
    <Teaser>Serbia with four unique leaders</Teaser>
    <Authors>Nikola</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>

