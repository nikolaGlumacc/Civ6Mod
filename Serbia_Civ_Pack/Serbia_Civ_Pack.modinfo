<?xml version="1.0" encoding="utf-8"?>
<Mod id="33b5f544-eb68-48d3-9919-0a827e907785" version="2">
  <Properties>
    <Name>Serbia Civilization Pack</Name>
    <Description>Adds Serbia featuring Josip Broz Tito, Draža Mihailović, Slobodan Milošević, and Stefan Dušan (Dušan Silni).</Description>
    <Teaser>Serbia Civilization Pack</Teaser>
    <Authors>Nikola</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>

  <Dependencies>
    <Mod id="1B28771A-C749-434B-9053-D1380C553DE9" title="Expansion: Rise and Fall" />
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
  </Dependencies>

  <FrontEndActions>
    <UpdateDatabase id="Serbia_Config_DB">
      <File>Config/Leader_Config.sql</File>
    </UpdateDatabase>
    <UpdateText id="Serbia_Config_Text">
      <File>Text/Localization.xml</File>
    </UpdateText>
    <UpdateIcons id="Serbia_Config_Icons">
      <File>Art/Icons.xml</File>
      <File>Art/Leader_Icons_Addon.xml</File>
    </UpdateIcons>
    <UpdateColors id="Serbia_Config_Colors">
      <File>Art/Colors.xml</File>
    </UpdateColors>
  </FrontEndActions>

  <InGameActions>
    <UpdateDatabase id="Serbia_Gameplay_DB">
      <File>Core/Civilization.xml</File>
      <File>Core/Leaders.sql</File>
      <File>Core/Units.xml</File>
      <File>Core/Buildings.xml</File>
      <File>Core/Improvements.xml</File>
      <File>Core/Agenda.xml</File>
      <File>Core/GreatPeople.sql</File>
    </UpdateDatabase>
    <UpdateText id="Serbia_Gameplay_Text">
      <File>Text/Localization.xml</File>
    </UpdateText>
    <UpdateIcons id="Serbia_Gameplay_Icons">
      <File>Art/Icons.xml</File>
      <File>Art/Leader_Icons_Addon.xml</File>
    </UpdateIcons>
    <UpdateColors id="Serbia_Gameplay_Colors">
      <File>Art/Colors.xml</File>
    </UpdateColors>
  </InGameActions>

  <Files>
    <File>Config/Leader_Config.sql</File>
    <File>Core/Civilization.xml</File>
    <File>Core/Leaders.sql</File>
    <File>Core/Units.xml</File>
    <File>Core/Buildings.xml</File>
    <File>Core/Improvements.xml</File>
    <File>Core/Agenda.xml</File>
    <File>Core/GreatPeople.sql</File>
    <File>Text/Localization.xml</File>
    <File>Art/Icons.xml</File>
    <File>Art/Leader_Icons_Addon.xml</File>
    <File>Art/Colors.xml</File>
  </Files>
</Mod>
