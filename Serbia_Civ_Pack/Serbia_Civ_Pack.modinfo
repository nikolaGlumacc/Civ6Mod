  <Properties>
    <Name>Serbia Civilization Pack</Name>
    <Description>Serbia with Tito, Draza, Milosevic, Dusan. v25: LoadingInfo in gameplay DB, WW2-safe UnitUpgrades (no Cuirassier), Replace colors.</Description>
    <Teaser>Serbia with four unique leaders — WW2 compatible</Teaser>
    <Authors>Nikola</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>

