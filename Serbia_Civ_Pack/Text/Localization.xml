    <Replace Tag="LOC_TRAIT_CIVILIZATION_SERBIA_NAME" Language="en_US">
      <Text>Raskrsce Svetova</Text>
    </Replace>
    <Replace Tag="LOC_TRAIT_CIVILIZATION_SERBIA_DESCRIPTION" Language="en_US">
      <Text>Trade Routes through Serbian territory yield +2 Gold and +1 Culture. Roads upgrade one tier earlier. Strategic and luxury mines yield +1 Production and +1 Faith. Defensive structures provide +1 Culture and +1 Loyalty per turn.</Text>
    </Replace>

    <Replace Tag="LOC_TRAIT_CIVILIZATION_CROSSROADS_NAME" Language="en_US">
      <Text>Raskrsce Svetova</Text>
    </Replace>
    <Replace Tag="LOC_TRAIT_CIVILIZATION_CROSSROADS_DESCRIPTION" Language="en_US">
      <Text>Trade Routes through Serbian territory yield +2 Gold and +1 Culture. Roads upgrade one tier earlier. Strategic and luxury mines yield +1 Production and +1 Faith. Defensive structures provide +1 Culture and +1 Loyalty per turn.</Text>
    </Replace>

    <!-- LEADERS -->
    <Replace Tag="LOC_LEADER_TITO_NAME" Language="en_US">
      <Text>Josip Broz Tito</Text>
    </Replace>
    <Replace Tag="LOC_LEADER_DRAZA_NAME" Language="en_US">
      <Text>Draza Mihailovic</Text>
