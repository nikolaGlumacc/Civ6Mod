      <GridButton ID="BtnBuilder"   Size="280,32" Style="MainButton" String="Spawn Builder"/>
      <GridButton ID="BtnSettler"   Size="280,32" Style="MainButton" String="Spawn Settler"/>
      <GridButton ID="BtnWarrior"   Size="280,32" Style="MainButton" String="Spawn Warrior"/>
