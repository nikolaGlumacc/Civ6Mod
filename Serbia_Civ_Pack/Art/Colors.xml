<!--
  Only define Serbia's unique player colors.
  Do NOT insert COLOR_UNKNOWN or any base-game color — that causes
  UNIQUE constraint failures and breaks the civilization select screen.
-->
<GameInfo>
  <Colors>
    <Replace Type="COLOR_PLAYER_SERBIA_PRIMARY" Color="199,30,40,255"/>
    <Replace Type="COLOR_PLAYER_SERBIA_SECONDARY" Color="10,50,140,255"/>
  </Colors>
  <PlayerColors>
    <Replace Type="CIVILIZATION_SERBIA" Usage="Unique" PrimaryColor="COLOR_PLAYER_SERBIA_PRIMARY" SecondaryColor="COLOR_PLAYER_SERBIA_SECONDARY"/>
  </PlayerColors>
</GameInfo>
