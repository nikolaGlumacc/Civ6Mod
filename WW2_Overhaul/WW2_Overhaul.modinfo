<?xml version="1.0" encoding="utf-8"?>
<Mod id="WW2_Overhaul" version="0.6">
  <Properties>
    <Name>WW2 Overhaul (Ruleset)</Name>
    <Teaser>City Supply Depots • National Stubbornness surge • Stronger Industry • Selectable Army Doctrine</Teaser>
    <Description>WW2 ruleset. Supply is now city/regional (Supply Depot). National Stubbornness gives a 25-turn production + combat surge when you lose territory (5-turn cooldown). Stronger Industrial Zones. Selectable Light/Medium/Heavy Army. Wildcard policies. Compatible with Serbia Civ Pack. Europe true-start foundation included.</Description>
    <Authors>nikolaGlumacc</Authors>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>

  <Dependencies>
    <Dependency id="1B28771A-C749-434B-9950-D51BDF21C6EA" title="Expansion: Rise and Fall"/>
    <Dependency id="4873eb62-8ccc-4574-b784-dda4558df0c1" title="Expansion: Gathering Storm"/>
  </Dependencies>

  <References>
    <Reference id="33b5f544-eb68-48d3-9919-0a827e907785" title="Serbia Civilization Pack"/>
  </References>

  <ActionCriteria>
    <Criteria id="Always"><AlwaysMet/></Criteria>
    <Criteria id="Expansion1and2"><RuleSet>RULESET_EXPANSION_2</RuleSet></Criteria>
  </ActionCriteria>

  <ActionGroups>
    <ActionGroup id="WW2_Gameplay" scope="game" criteria="Expansion1and2">
      <Actions>
        <UpdateDatabase>
          <Item>Data/WW2_Victories.sql</Item>
          <Item>Data/WW2_Loyalty.sql</Item>
          <Item>Data/WW2_Combat.sql</Item>
          <Item>Data/WW2_Promotions_Formations.sql</Item>
          <Item>Data/WW2_Resources.sql</Item>
          <Item>Data/WW2_Production.sql</Item>
          <Item>Data/WW2_Start.sql</Item>
          <Item>Data/WW2_Yugoslavia.sql</Item>
          <Item>Data/WW2_Policies.sql</Item>
          <Item>Data/WW2_Supply.sql</Item>
          <Item>Data/WW2_ArmyDoctrines.sql</Item>
          <Item>Data/WW2_Ideology.sql</Item>
          <Item>Data/WW2_Config.sql</Item>
          <Item>Data/WW2_EuropeStart.sql</Item>
        </UpdateDatabase>
        <AddGameplayScripts>
          <Item>Lua/WW2_OilMaintenance.lua</Item>
          <Item>Lua/WW2_StartLogic.lua</Item>
          <Item>Lua/WW2_WarWeariness.lua</Item>
          <Item>Lua/WW2_Config.lua</Item>
          <Item>Lua/WW2_ArmyDoctrine.lua</Item>
          <Item>Lua/WW2_Stubbornness.lua</Item>
        </AddGameplayScripts>
      </Actions>
    </ActionGroup>

    <ActionGroup id="WW2_Text" scope="game" criteria="Always">
      <Actions>
        <UpdateText>
          <Item>Text/WW2_Text.xml</Item>
        </UpdateText>
      </Actions>
    </ActionGroup>
  </ActionGroups>
</Mod>
