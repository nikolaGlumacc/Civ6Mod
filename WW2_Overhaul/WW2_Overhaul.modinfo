<?xml version="1.0" encoding="utf-8"?>
<Mod id="WW2_Overhaul" version="0.2">
  <Properties>
    <Name>WW2 Overhaul (Ruleset)</Name>
    <Teaser>1936 start • Domination only • Stronger wars • HOI4-style • Full Rise &amp; Fall features</Teaser>
    <Description>Full WW2-focused overhaul built on top of Rise and Fall + Gathering Storm ruleset. Keeps Dark Ages, Golden Ages, Governors, Emergencies, etc. Only Domination victory. Loyalty pressure disabled for long wars. Stronger city damage, navy, air, promotions and formations. Oil maintenance. Free civ/leader choice supported. Sample Yugoslavia included. 1936-style start.</Description>
    <Authors>nikolaGlumacc</Authors>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>

  <!-- Requires the expansions so Dark Ages / Golden Ages / Governors / etc. are present -->
  <Dependencies>
    <Dependency id="1B28771A-C749-434B-9950-D51BDF21C6EA" title="Expansion: Rise and Fall"/>
    <Dependency id="4873eb62-8ccc-4574-b784-dda4558df0c1" title="Expansion: Gathering Storm"/>
  </Dependencies>

  <ActionCriteria>
    <Criteria id="Always">
      <AlwaysMet/>
    </Criteria>
    <Criteria id="Expansion1and2">
      <RuleSet>RULESET_EXPANSION_2</RuleSet>
    </Criteria>
  </ActionCriteria>

  <ActionGroups>
    <!-- Main gameplay changes - only load with RF+GS ruleset -->
    <ActionGroup id="WW2_Gameplay" scope="game" criteria="Expansion1and2">
      <Actions>
        <UpdateDatabase>
          <Item>Data/WW2_Victories.sql</Item>
          <Item>Data/WW2_Loyalty.sql</Item>
          <Item>Data/WW2_Combat.sql</Item>
          <Item>Data/WW2_Promotions_Formations.sql</Item>
          <Item>Data/WW2_Resources.sql</Item>
          <Item>Data/WW2_Production.sql</Item>
          <Item>Data/WW2_Start.sql</Item>
          <Item>Data/WW2_Yugoslavia.sql</Item>
        </UpdateDatabase>
        <AddGameplayScripts>
          <Item>Lua/WW2_OilMaintenance.lua</Item>
          <Item>Lua/WW2_StartLogic.lua</Item>
        </AddGameplayScripts>
      </Actions>
    </ActionGroup>

    <!-- Text / localization -->
    <ActionGroup id="WW2_Text" scope="game" criteria="Always">
      <Actions>
        <UpdateText>
          <Item>Text/WW2_Text.xml</Item>
        </UpdateText>
      </Actions>
    </ActionGroup>
  </ActionGroups>
</Mod>
