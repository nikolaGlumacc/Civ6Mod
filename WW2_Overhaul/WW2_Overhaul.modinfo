<?xml version="1.0" encoding="utf-8"?>
<Mod id="WW2_Overhaul" version="2.0">
  <Properties>
    <Name>WW2 Overhaul</Name>
    <Teaser>v2.0 • HOI4-style WW2 ruleset • Domination only • Industrial start • Serbia compatible</Teaser>
    <Description>WW2 Overhaul ruleset (RF+GS): Domination-only, Industrial start, hard science, oil, supply, army doctrine, national stubbornness, join/absorb diplomacy, ideology bonuses. Compatible with Serbia Civilization Pack without redefining its leaders.</Description>
    <Authors>nikolaGlumacc</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>

  <Dependencies>
    <Mod id="1B28771A-C749-434B-9053-D1380C553DE9" title="Expansion: Rise and Fall"/>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm"/>
  </Dependencies>

  <References>
    <Mod id="33b5f544-eb68-48d3-9919-0a827e907785" title="Serbia Civilization Pack"/>
  </References>

  <FrontEndActions>
    <UpdateDatabase id="WW2_Config_DB">
      <File>Data/WW2_Ruleset.xml</File>
      <File>Data/WW2_Frontend_Players.sql</File>
    </UpdateDatabase>
    <UpdateText id="WW2_Config_Text">
      <File>Text/WW2_Text.xml</File>
    </UpdateText>
  </FrontEndActions>

  <InGameActions>
    <UpdateDatabase id="WW2_Gameplay_DB">
      <Properties>
        <RuleSet>RULESET_WW2,RULESET_EXPANSION_2</RuleSet>
      </Properties>
      <File>Data/WW2_Victories.sql</File>
      <File>Data/WW2_Loyalty.sql</File>
      <File>Data/WW2_Combat.sql</File>
      <File>Data/WW2_Promotions_Formations.sql</File>
      <File>Data/WW2_Resources.sql</File>
      <File>Data/WW2_Production.sql</File>
      <File>Data/WW2_Science.sql</File>
      <File>Data/WW2_Start.sql</File>
      <File>Data/WW2_Yugoslavia.sql</File>
      <File>Data/WW2_Policies.sql</File>
      <File>Data/WW2_Supply.sql</File>
      <File>Data/WW2_ArmyDoctrines.sql</File>
      <File>Data/WW2_Ideology.sql</File>
      <File>Data/WW2_Config.sql</File>
      <File>Data/WW2_EuropeStart.sql</File>
      <File>Data/WW2_Stubbornness.sql</File>
      <File>Data/WW2_JoinPower.sql</File>
      <File>Data/WW2_EuropeGuide.sql</File>
    </UpdateDatabase>

    <UpdateText id="WW2_Gameplay_Text">
      <File>Text/WW2_Text.xml</File>
    </UpdateText>

    <AddGameplayScripts id="WW2_Gameplay_Scripts">
      <File>Lua/WW2_Config.lua</File>
      <File>Lua/WW2_OilMaintenance.lua</File>
      <File>Lua/WW2_StartLogic.lua</File>
      <File>Lua/WW2_ArmyDoctrine.lua</File>
      <File>Lua/WW2_Stubbornness.lua</File>
      <File>Lua/WW2_WarWeariness.lua</File>
      <File>Lua/WW2_JoinPower.lua</File>
      <File>Lua/WW2_JoinDiplomacy.lua</File>
    </AddGameplayScripts>
  </InGameActions>

  <Files>
    <File>Data/WW2_Ruleset.xml</File>
    <File>Data/WW2_Frontend_Players.sql</File>
    <File>Data/WW2_Victories.sql</File>
    <File>Data/WW2_Loyalty.sql</File>
    <File>Data/WW2_Combat.sql</File>
    <File>Data/WW2_Promotions_Formations.sql</File>
